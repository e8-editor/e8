# A worktree's target is a symlink to the main checkout's (.claude/hooks/share-target.sh).
/target
# A worktree's own app, which make app builds there.
/E8.app
spikes/*/target/
.DS_Store

# Claude Code's worktrees, one per session working on a branch.
.claude/worktrees/
# Settings and approvals of this machine's own.
.claude/settings.local.json

# Secrets and personal data never belong in this repository.
.env
*.key

# Written by egui_kittest when a snapshot differs; the committed .png is the reference.
*.new.png
*.diff.png
*.old.png

# What crates/e8-web/build.sh builds.
/crates/e8-web/web/pkg/
__pycache__/
